{
  "name": "@drincs/roves-cli",
  "description": "Command-line tool and Node.js API that package a built web game as a native Roves app (CEF player on Windows/macOS/Linux, WebView on Android/iOS).",
  "version": "0.5.0",
  "type": "module",
  "license": "MPL-2.0",
  "author": "DRincs Productions",
  "homepage": "https://github.com/DRincs-Productions/roves-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DRincs-Productions/roves-cli.git"
  },
  "bugs": {
    "url": "https://github.com/DRincs-Productions/roves-cli/issues"
  },
  "bin": {
    "roves": "./dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup --config tsup.config.ts",
    "lint": "biome lint",
    "check": "biome check",
    "format": "biome format --write",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "build:sea": "node scripts/build-sea.mjs"
  },
  "keywords": [
    "roves",
    "cef",
    "game",
    "packaging",
    "bundle",
    "desktop",
    "android",
    "ios",
    "steam",
    "visual-novel",
    "cli"
  ],
  "dependencies": {
    "@jimp/core": "^1.7.0",
    "@jimp/js-png": "^1.7.0",
    "@jimp/plugin-resize": "^1.7.0",
    "commander": "^14.0.3",
    "decode-ico": "^0.4.1",
    "env-paths": "^4.0.0",
    "plist": "^5.1.2",
    "resedit": "^3.1.1",
    "semver": "^7.8.6",
    "tinyglobby": "^0.2.17",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^20.19.43",
    "@types/plist": "^3.0.5",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
